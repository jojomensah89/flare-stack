{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flare-reference-web",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flare-reference-web-production",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "vars": {
    "FLARE_ENVIRONMENT": "production",
    "AUTH_ALLOWED_HOSTS": "__SET_AUTH_ALLOWED_HOSTS__",
    "AUTH_PROTOCOL": "https",
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "previews": {
    "vars": {
      "FLARE_ENVIRONMENT": "preview",
      "AUTH_ALLOWED_HOSTS": "__SET_AUTH_ALLOWED_HOSTS__",
      "AUTH_PROTOCOL": "https",
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "flare-reference-web-preview",
        "database_id": "00000000-0000-0000-0000-000000000002",
        "migrations_dir": "../../packages/db/migrations",
      },
    ],
  },
  "env": {
    "development": {
      "secrets": {
        "required": ["BETTER_AUTH_SECRET"],
      },
      "vars": {
        "FLARE_ENVIRONMENT": "development",
        "AUTH_ALLOWED_HOSTS": "localhost:5173",
        "AUTH_PROTOCOL": "http",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flare-reference-web-development",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
    },
    "preview": {
      "secrets": {
        "required": ["BETTER_AUTH_SECRET"],
      },
      "vars": {
        "FLARE_ENVIRONMENT": "preview",
        "AUTH_ALLOWED_HOSTS": "__SET_AUTH_ALLOWED_HOSTS__",
        "AUTH_PROTOCOL": "https",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flare-reference-web-preview",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
  },
}
