{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "ignorePatterns": [
    "docs/flare-stack-spec-*.md",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts",
    "**/dist/**",
    "**/.wrangler/**",
    "**/.turbo/**",
    "**/node_modules/**"
  ]
}
