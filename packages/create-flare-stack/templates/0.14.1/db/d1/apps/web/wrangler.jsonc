{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{PROJECT_NAME}}-web",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "{{PROJECT_NAME}}-production",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "secrets": {
    "required": [],
  },
  "vars": {
    "FLARE_ENVIRONMENT": "production",
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "previews": {
    "vars": {
      "FLARE_ENVIRONMENT": "preview",
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "{{PROJECT_NAME}}-preview",
        "database_id": "00000000-0000-0000-0000-000000000002",
        "migrations_dir": "../../packages/db/migrations",
      },
    ],
  },
  "env": {
    "development": {
      "secrets": {
        "required": [],
      },
      "vars": {
        "FLARE_ENVIRONMENT": "development",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "{{PROJECT_NAME}}-development",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
    },
    "preview": {
      "secrets": {
        "required": [],
      },
      "vars": {
        "FLARE_ENVIRONMENT": "preview",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "{{PROJECT_NAME}}-preview",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
  },
}
