{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:staged": "bun scripts/lint-staged.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "verify": "bun run check && bun run build",
    "preview": "flare preview",
    "deploy": "flare deploy",
    "deploy:cloudflare": "flare deploy --cloudflare-only",
    "setup": "bun run ./scripts/setup.ts",
    "db:generate": "bun run --filter @repo/db generate:neon",
    "db:migrate": "flare db migrate --env local",
    "db:migrate:preview": "flare db migrate --env preview",
    "db:migrate:prod": "flare db migrate --env production",
    "db:status": "flare db status --env local",
    "db:studio": "bun run --filter @repo/db studio"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@neondatabase/serverless": "1.1.0",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@shadcn/lint": "0.2.0",
    "@types/bun": "1.4.2",
    "@types/node": "24.13.3",
    "flare": "0.14.1",
    "lefthook": "2.1.15",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.5",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
