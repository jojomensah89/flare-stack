{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "{{PROJECT_NAME}}-server",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"],
  },
  "vars": {
    "FLARE_ENVIRONMENT": "production",
    "AUTH_ALLOWED_HOSTS": "__SET_AUTH_ALLOWED_HOSTS__",
    "AUTH_PROTOCOL": "https",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "{{PROJECT_NAME}}-production",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "env": {
    "development": {
      "secrets": {
        "required": ["BETTER_AUTH_SECRET"],
      },
      "vars": {
        "FLARE_ENVIRONMENT": "development",
        "AUTH_ALLOWED_HOSTS": "localhost:5173",
        "AUTH_PROTOCOL": "http",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "{{PROJECT_NAME}}-development",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
    },
    "preview": {
      "name": "{{PROJECT_NAME}}-server-preview",
      "workers_dev": false,
      "preview_urls": false,
      "secrets": {
        "required": ["BETTER_AUTH_SECRET"],
      },
      "vars": {
        "FLARE_ENVIRONMENT": "preview",
        "AUTH_ALLOWED_HOSTS": "__SET_AUTH_ALLOWED_HOSTS__",
        "AUTH_PROTOCOL": "https",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "{{PROJECT_NAME}}-preview",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
    },
  },
}
