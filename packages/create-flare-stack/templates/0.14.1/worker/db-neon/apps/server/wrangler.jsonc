{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "{{PROJECT_NAME}}",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "workers_dev": true,
  "secrets": {
    "required": ["DATABASE_URL"],
  },
  "vars": {
    "FLARE_ENVIRONMENT": "production",
  },
  "previews": {
    "secrets": {
      "required": ["DATABASE_URL"],
    },
    "vars": {
      "FLARE_ENVIRONMENT": "preview",
    },
  },
  "env": {
    "development": {
      "secrets": {
        "required": ["DATABASE_URL"],
      },
      "vars": {
        "FLARE_ENVIRONMENT": "development",
      },
    },
    "preview": {
      "name": "{{PROJECT_NAME}}-preview",
      "secrets": {
        "required": ["DATABASE_URL"],
      },
      "vars": {
        "FLARE_ENVIRONMENT": "preview",
      },
    },
  },
  "observability": {
    "enabled": true,
  },
}
